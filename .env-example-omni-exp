# ============================================================
# Omni-exp focused .env example (sanitized from a working host)
# Copy to `.env` and fill secrets. Docs:
#   docs/omni-exp-agent-design.md (Fresh Mac bootstrap)
#   docs/omni-exp-research-mode.md
#   docs/omni-exp-whiteboard-meeting-capture.md
# ============================================================

# --- Core / shared (fill real values) ---
# Google AI Studio — https://ai.google.dev
GEMINI_API_KEY=your-gemini-key

# Ports (voice / agent-api / dashboard — keep distinct from OMNI_EXP_PORT)
PORT=7980
AGENT_API_PORT=7950
DASHBOARD_PORT=7951

# Optional LiveKit (only if you also run voice-agent / LiveKit path)
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=your-livekit-api-key
# LIVEKIT_API_SECRET=your-livekit-api-secret

# --- Qwen realtime (required for omni-exp camera+voice) ---
REALTIME_PROVIDER=qwen
DASHSCOPE_API_KEY=your-dashscope-api-key
REALTIME_MODEL=qwen3.5-omni-plus-realtime
QWEN_OMNI_REALTIME_MODEL=qwen3.5-omni-plus-realtime
# Region endpoints (key must match region — CN key ≠ INTL endpoint)
DASHSCOPE_ENDPOINT_CN=https://dashscope.aliyuncs.com/api-ws/v1/realtime
DASHSCOPE_ENDPOINT_INTL=https://dashscope-intl.aliyuncs.com/api-ws/v1/realtime
DASHSCOPE_ENDPOINT_CN_LEGACY=https://dashscope.aliyuncs.com/api-ws/v1
# Active base URL WITHOUT trailing /realtime for TS; omni accepts either.
# CN example (China key):
REALTIME_BASE_URL=https://dashscope.aliyuncs.com/api-ws/v1
# INTL example (Singapore key):
# REALTIME_BASE_URL=https://dashscope-intl.aliyuncs.com/api-ws/v1

# --- Optional owner crons (off for omni-focused hosts) ---
SUTANDO_PROACTIVE_LOOP_ENABLED=0
SUTANDO_MORNING_BRIEFING_ENABLED=0
SUTANDO_DAILY_INSIGHT_ENABLED=0
SUTANDO_PENDING_QUESTIONS_CRON_ENABLED=0
SUTANDO_SYNC_MEMORY_CRON_ENABLED=0

# Boot session-recap: fast mechanical extract by default (see session-recap skill).
# SUTANDO_SESSION_RECAP_ON_BOOT=0
# SUTANDO_SESSION_RECAP_BOOT_MAX_CHARS=48000

# Omni Start-core sets this automatically; optional for manual start-cli.
# SUTANDO_SKIP_STARTUP=1

# --- Omni-exp phone / research agent ---
OMNI_EXP_AUTH_REQUIRED=0
OMNI_EXP_PORT=7090
OMNI_EXP_AUTO_START=1
# Default: demo. Also: research | no_gui_html_output | no_gui | normal_with_gui
# demo = one scrollable HTML page with exactly 4 topics (no TTS / auto-play)
OMNI_EXP_MODE=demo
OMNI_EXP_SCENE_CHANGE=1
OMNI_EXP_SCENE_COOLDOWN_MS=30000
OMNI_EXP_SCENE_THRESHOLD=28
OMNI_EXP_UPLOAD_DEDUPE=6.3
OMNI_EXP_UPLOAD_KEEPALIVE_S=8
OMNI_EXP_WORK_RESULT_MERGE=serial
OMNI_EXP_SPEAK_QUEUE_MAX=32
# 1 = wipe recent-done / research-capture on each session.start (default off)
OMNI_EXP_CLEAR_CONTEXT_ON_START=0

# Whiteboard / meeting capture (MODE=research). Phase-2 extras opt-in.
OMNI_EXP_RESEARCH_FLUSH_IDLE_S=90
OMNI_EXP_RESEARCH_FLUSH_MIN_INTERVAL_S=45
OMNI_EXP_RESEARCH_FLUSH_HOOK_COUNT=5
# OMNI_EXP_RESEARCH_SCENE_THRESHOLD=22
OMNI_EXP_RESEARCH_MASK_UPPER=0.35
OMNI_EXP_RESEARCH_PERSIST=1
OMNI_EXP_RESEARCH_BOARD_INK=0
OMNI_EXP_RESEARCH_BOARD_OCR=0
OMNI_EXP_RESEARCH_MEETING_SCAN_S=0

# OpenRouter / non-Anthropic cores: inject TASK_FILE into sutando-core tmux
SUTANDO_TMUX_TASK_FEEDER=1

# Optional: allow omni UI Start/Stop core (default usually on in code)
# OMNI_EXP_ALLOW_START_CORE=1
